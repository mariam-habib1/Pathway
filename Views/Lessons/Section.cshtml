@model Pathway.ViewModels.LessonsPageViewModel

@{
    ViewData["Title"] = $"{Model.SectionTitle} - Lessons";
}

<div class="pw-page">
    <div class="pw-page-header">
        <div>
            <h2>@Model.SectionTitle</h2>
            <p class="pw-subtitle">Lessons in this section</p>
        </div>
        @if (Model.CanManage)
        {
            <a asp-action="Create" asp-route-sectionId="@Model.SectionId" class="pw-btn pw-btn-primary">+ New Lesson</a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div>
    }

    @if (!Model.Lessons.Any())
    {
        <div class="pw-empty">No lessons in this section yet.</div>
    }
    else
    {
        <div class="pw-card">
            @foreach (var lesson in Model.Lessons.OrderBy(l => l.Order))
            {
                <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                    <a asp-action="Details" asp-route-id="@lesson.LessonId" class="fw-bold">@lesson.Order. @lesson.Title</a>
                    @if (Model.CanManage)
                    {
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@lesson.LessonId" class="pw-btn pw-btn-ghost pw-btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@lesson.LessonId" class="pw-btn pw-btn-danger pw-btn-sm">Delete</a>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (Model.CanManage)
    {
        <a asp-controller="CourseSections" asp-action="Course" asp-route-courseId="@Model.CourseId" class="pw-btn pw-btn-ghost mt-3">← Back to Sections</a>
    }
    else
    {
        <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId" class="pw-btn pw-btn-ghost mt-3">← Back to Course</a>
    }
</div>
