@model Pathway.ViewModels.LessonFormViewModel

@{
    ViewData["Title"] = "New Lesson";
}

<div class="pw-page">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="pw-page-header">
                <div>
                    <h2>New Lesson</h2>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="pw-card">
                <form asp-action="Create" asp-route-sectionId="@Model.SectionId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="SectionId" />

                    <div class="mb-3">
                        <label asp-for="Title"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Content"></label>
                        <textarea asp-for="Content" class="form-control" rows="6"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="VideoUrl"></label>
                        <input asp-for="VideoUrl" class="form-control" placeholder="https://..." />
                        <span asp-validation-for="VideoUrl" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Order"></label>
                        <input asp-for="Order" type="number" min="1" class="form-control" />
                        <span asp-validation-for="Order" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="pw-btn pw-btn-primary">Create Lesson</button>
                        <a asp-action="Section" asp-route-sectionId="@Model.SectionId" class="pw-btn pw-btn-ghost">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
