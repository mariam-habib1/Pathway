@model Pathway.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
}

<div class="pw-page">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="pw-page-header">
                <div>
                    <h2>Create your account</h2>
                    <p class="pw-subtitle">Join as a student or start teaching on Pathway.</p>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="pw-card">
                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword"></label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Role"></label>
                        <select asp-for="Role" class="form-select">
                            <option value="Student">Student</option>
                            <option value="Instructor">Instructor</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>

                    <button type="submit" class="pw-btn pw-btn-primary w-100">Create account</button>
                </form>
            </div>

            <p class="text-center mt-3 text-muted">Already have an account? <a asp-action="Login">Log in here</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
