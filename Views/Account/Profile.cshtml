@model Pathway.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    var initials = string.Join("", Model.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));
    var badgeClass = "pw-badge-student";
    if (Model.Role == "Admin")
    {
        badgeClass = "pw-badge-admin";
    }
    else if (Model.Role == "Instructor")
    {
        badgeClass = "pw-badge-instructor";
    }
}

<div class="pw-page">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="pw-page-header">
                <div>
                    <h2>My Profile</h2>
                    <p class="pw-subtitle">Your account details.</p>
                </div>
            </div>

            <div class="pw-card">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="pw-avatar-lg">@initials</span>
                    <div>
                        <div class="fw-bold fs-5">@Model.Name</div>
                        <span class="pw-badge @badgeClass">@Model.Role</span>
                    </div>
                </div>

                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4 text-muted">Member Since</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
