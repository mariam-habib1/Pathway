@{
    ViewData["Title"] = "About";
}

<div class="pw-page">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="pw-page-header">
                <div>
                    <h2>About Pathway</h2>
                </div>
            </div>

            <div class="pw-card">
                <p>
                    Pathway is an online learning platform that connects students with instructors across a wide
                    range of subjects, from programming and cyber security to artificial intelligence and web development.
                </p>
                <p class="mb-0">
                    Instructors can create courses, organize them into sections and lessons, and track student progress,
                    while students can browse courses, enroll, and learn at their own pace.
                </p>
            </div>
        </div>
    </div>
</div>
