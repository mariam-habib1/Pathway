@model Pathway.ViewModels.CategoryFormViewModel

@{
    ViewData["Title"] = "New Category";
}

<div class="pw-page">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="pw-page-header">
                <div>
                    <h2>New Category</h2>
                    <p class="pw-subtitle">Add a subject area for courses to live under.</p>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="pw-card">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="pw-btn pw-btn-primary">Create</button>
                        <a asp-action="Index" class="pw-btn pw-btn-ghost">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
