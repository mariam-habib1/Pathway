@model Pathway.ViewModels.StudentDashboardViewModel

@{
    ViewData["Title"] = "My Courses";
}

<div class="pw-page">
    <div class="pw-page-header">
        <div>
            <h2>My Dashboard</h2>
            <p class="pw-subtitle">Courses you're enrolled in.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div>
    }

    <div class="row mb-4">
        <div class="col-md-3 col-6">
            <div class="pw-mini-stat">
                <div class="value">@Model.TotalCourses</div>
                <div class="label">Total Courses</div>
            </div>
        </div>
    </div>

    <h4 class="mb-3">My Enrolled Courses</h4>

    @if (!Model.Enrollments.Any())
    {
        <div class="pw-empty">You are not enrolled in any courses yet.</div>
    }
    else
    {
        <div class="pw-card">
            <table class="pw-table">
                <thead>
                    <tr>
                        <th>Course</th>
                        <th>Instructor</th>
                        <th>Category</th>
                        <th>Enrolled At</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Enrollments)
                    {
                        <tr>
                            <td>@item.CourseTitle</td>
                            <td>@item.InstructorName</td>
                            <td>@item.CategoryName</td>
                            <td>@item.EnrolledAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-controller="Courses" asp-action="Details" asp-route-id="@item.CourseId" class="pw-btn pw-btn-primary pw-btn-sm">Details</a>
                                    <a asp-action="Cancel" asp-route-id="@item.EnrollmentId" class="pw-btn pw-btn-danger pw-btn-sm">Cancel</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
