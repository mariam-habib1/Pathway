@model Pathway.ViewModels.EnrollmentViewModel

@{
    ViewData["Title"] = "Cancel Enrollment";
}

<div class="pw-page">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="pw-page-header">
                <div>
                    <h2>Cancel Enrollment</h2>
                </div>
            </div>

            <div class="pw-card">
                <p>Are you sure you want to cancel your enrollment in <strong>@Model.CourseTitle</strong>?</p>

                <form asp-action="Cancel" asp-route-id="@Model.EnrollmentId" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="pw-btn pw-btn-danger">Yes, Cancel</button>
                    <a asp-action="MyCourses" class="pw-btn pw-btn-ghost">No, Go Back</a>
                </form>
            </div>
        </div>
    </div>
</div>
