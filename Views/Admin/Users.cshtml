@model List<Pathway.ViewModels.AdminUserListItemViewModel>

@{
    ViewData["Title"] = "Manage Users";

    string BadgeClass(string role)
    {
        if (role == "Admin") return "pw-badge-admin";
        if (role == "Instructor") return "pw-badge-instructor";
        return "pw-badge-student";
    }
}

<div class="pw-page">
    <div class="pw-page-header">
        <div>
            <h2>Manage Users</h2>
            <p class="pw-subtitle">@Model.Count user(s) on the platform</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div>
    }

    <div class="pw-card">
        <table class="pw-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Joined</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Name</td>
                        <td>@user.Email</td>
                        <td><span class="pw-badge @BadgeClass(user.Role)">@user.Role</span></td>
                        <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="UserDetails" asp-route-id="@user.UserId" class="pw-btn pw-btn-primary pw-btn-sm">Details</a>
                                <a asp-action="UserEdit" asp-route-id="@user.UserId" class="pw-btn pw-btn-ghost pw-btn-sm">Edit</a>
                                <a asp-action="UserDelete" asp-route-id="@user.UserId" class="pw-btn pw-btn-danger pw-btn-sm">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
