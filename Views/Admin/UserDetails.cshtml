@model Pathway.ViewModels.AdminUserDetailsViewModel

@{
    ViewData["Title"] = "User Details";
}

<div class="pw-page">
    <div class="pw-page-header">
        <div>
            <h2>@Model.Name</h2>
            <p class="pw-subtitle">@Model.Role</p>
        </div>
    </div>

    <div class="pw-card">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3 text-muted">Role</dt>
            <dd class="col-sm-9">@Model.Role</dd>

            <dt class="col-sm-3 text-muted">Joined</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("dd MMM yyyy")</dd>
        </dl>
    </div>

    @if (Model.Role == "Instructor")
    {
        <h5 class="mt-4 mb-3">Courses (@Model.Courses.Count)</h5>
        @if (!Model.Courses.Any())
        {
            <div class="pw-empty">No courses yet.</div>
        }
        else
        {
            <div class="pw-card">
                @foreach (var course in Model.Courses)
                {
                    <div class="py-2 border-bottom">
                        <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.CourseId">@course.Title</a>
                    </div>
                }
            </div>
        }
    }
    else if (Model.Role == "Student")
    {
        <h5 class="mt-4 mb-3">Enrollments (@Model.Enrollments.Count)</h5>
        @if (!Model.Enrollments.Any())
        {
            <div class="pw-empty">No enrollments yet.</div>
        }
        else
        {
            <div class="pw-card">
                @foreach (var enrollment in Model.Enrollments)
                {
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <a asp-controller="Courses" asp-action="Details" asp-route-id="@enrollment.CourseId">@enrollment.CourseTitle</a>
                        <span class="pw-mono text-muted">@enrollment.Progress%</span>
                    </div>
                }
            </div>
        }
    }

    <div class="d-flex gap-2 mt-4">
        <a asp-action="UserEdit" asp-route-id="@Model.UserId" class="pw-btn pw-btn-primary">Edit</a>
        <a asp-action="Users" class="pw-btn pw-btn-ghost">← Back to Users</a>
    </div>
</div>
