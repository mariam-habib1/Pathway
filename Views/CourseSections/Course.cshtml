@model Pathway.ViewModels.CourseSectionsPageViewModel

@{
    ViewData["Title"] = $"{Model.CourseTitle} - Sections";
}

<div class="pw-page">
    <div class="pw-page-header">
        <div>
            <h2>@Model.CourseTitle</h2>
            <p class="pw-subtitle">Manage sections</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" asp-route-courseId="@Model.CourseId" class="pw-btn pw-btn-ghost">+ Add Single Section</a>
            <a asp-action="BuildContent" asp-route-courseId="@Model.CourseId" class="pw-btn pw-btn-primary">+ Add Content</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div>
    }

    @if (!Model.Sections.Any())
    {
        <div class="pw-empty">No sections yet. Add your first section to start building the course content.</div>
    }
    else
    {
        <div class="pw-card">
            @foreach (var section in Model.Sections.OrderBy(s => s.Order))
            {
                <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                    <div>
                        <span class="fw-bold">@(section.Order). @(section.Title)</span>
                        <span class="text-muted small ms-2">(@(section.LessonCount) lesson(s))</span>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-controller="Lessons" asp-action="Section" asp-route-sectionId="@(section.SectionId)" class="pw-btn pw-btn-primary pw-btn-sm">Lessons</a>
                        <a asp-action="Edit" asp-route-id="@(section.SectionId)" class="pw-btn pw-btn-ghost pw-btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@(section.SectionId)" class="pw-btn pw-btn-danger pw-btn-sm">Delete</a>
                    </div>
                </div>
            }
        </div>
    }

    <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId" class="pw-btn pw-btn-ghost mt-3">← Back to Course</a>
</div>

