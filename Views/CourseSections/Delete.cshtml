@model Pathway.ViewModels.CourseSectionFormViewModel

@{
    ViewData["Title"] = "Delete Section";
}

<div class="pw-page">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="pw-page-header">
                <div>
                    <h2>Delete Section</h2>
                </div>
            </div>

            <div class="pw-card">
                <p>Are you sure you want to delete <strong>@Model.Title</strong>?</p>
                <div class="alert alert-warning">
                    This will also permanently delete all lessons inside this section.
                </div>

                <form asp-action="Delete" asp-route-id="@Model.SectionId" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="pw-btn pw-btn-danger">Yes, Delete</button>
                    <a asp-action="Course" asp-route-courseId="@Model.CourseId" class="pw-btn pw-btn-ghost">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
