@model List<Pathway.ViewModels.CourseViewModel>

@{
    ViewData["Title"] = "My Courses";
}

<div class="pw-page">
    <div class="pw-page-header">
        <div>
            <h2>My Courses</h2>
            <p class="pw-subtitle">Courses you're teaching.</p>
        </div>
        <a asp-action="Create" class="pw-btn pw-btn-primary">+ New Course</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div>
    }

    @if (!Model.Any())
    {
        <div class="pw-empty">You haven't created any courses yet.</div>
    }
    else
    {
        <div class="pw-card">
            <table class="pw-table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Created</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in Model)
                    {
                        <tr>
                            <td>@course.Title</td>
                            <td>@course.CategoryName</td>
                            <td class="pw-mono">@course.Price.ToString("C")</td>
                            <td>@course.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@course.CourseId" class="pw-btn pw-btn-primary pw-btn-sm">View</a>
                                    <a asp-action="Edit" asp-route-id="@course.CourseId" class="pw-btn pw-btn-ghost pw-btn-sm">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@course.CourseId" class="pw-btn pw-btn-danger pw-btn-sm">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
