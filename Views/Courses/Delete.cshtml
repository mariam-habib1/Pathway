@model Pathway.ViewModels.CourseDetailsViewModel

@{
    ViewData["Title"] = "Delete Course";
}

<div class="pw-page">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="pw-page-header">
                <div>
                    <h2>Delete Course</h2>
                </div>
            </div>

            <div class="pw-card">
                <p>Are you sure you want to delete <strong>@Model.Title</strong>?</p>

                @if (Model.Sections.Any() || Model.EnrollmentCount > 0)
                {
                    <div class="alert alert-warning">
                        This will also permanently delete @Model.Sections.Count section(s) and all their lessons,
                        and will remove @Model.EnrollmentCount student enrollment(s) from this course.
                    </div>
                }

                <form asp-action="Delete" asp-route-id="@Model.CourseId" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="pw-btn pw-btn-danger">Yes, Delete</button>
                    <a asp-action="Details" asp-route-id="@Model.CourseId" class="pw-btn pw-btn-ghost">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
