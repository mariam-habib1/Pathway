<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pathway</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="pw-navbar">
        <div class="container d-flex align-items-center justify-content-between">
            <a class="pw-brand" asp-controller="Home" asp-action="Index">
                <span class="pw-brand-mark">P</span> Pathway
            </a>

            <ul class="navbar-nav d-none d-lg-flex flex-row gap-1">
                <li class="nav-item"><a class="pw-nav-link" asp-controller="Courses" asp-action="Index">Courses</a></li>
                <li class="nav-item"><a class="pw-nav-link" asp-controller="Categories" asp-action="Index">Categories</a></li>
                @if (User.IsInRole("Student"))
                {
                    <li class="nav-item"><a class="pw-nav-link" asp-controller="Enrollments" asp-action="MyCourses">My Courses</a></li>
                }
                @if (User.IsInRole("Instructor"))
                {
                    <li class="nav-item"><a class="pw-nav-link" asp-controller="Courses" asp-action="MyCourses">My Courses</a></li>
                }
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item"><a class="pw-nav-link" asp-controller="Admin" asp-action="Index">Admin</a></li>
                }
            </ul>

            <div class="d-flex align-items-center gap-2">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    var displayName = User.Identity.Name ?? "?";
                    var initials = string.Join("", displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));
                    <a class="pw-user-chip" asp-controller="Account" asp-action="Profile">
                        <span class="pw-avatar-sm">@initials</span>
                        @displayName
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="pw-btn pw-btn-ghost">Log out</button>
                    </form>
                }
                else
                {
                    <a class="pw-nav-link" asp-controller="Account" asp-action="Login">Log in</a>
                    <a class="pw-btn pw-btn-primary" asp-controller="Account" asp-action="Register">Get Started</a>
                }
            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="pw-footer mt-5">
        <div class="container">
            <div class="row align-items-center pb-4">
                <div class="col-md-7">
                    <h2>Ready to start learning something new?</h2>
                    <p>Join Pathway and get access to courses taught by real practitioners.</p>
                </div>
                <div class="col-md-5 text-md-end">
                    <a asp-controller="Account" asp-action="Register" class="pw-btn pw-btn-dark">Create a free account</a>
                </div>
            </div>

            <div class="row py-4 pw-footer-links">
                <div class="col-6 col-md-3 mb-3">
                    <div class="fw-bold text-white mb-2">Platform</div>
                    <div><a asp-controller="Courses" asp-action="Index">Browse Courses</a></div>
                    <div><a asp-controller="Categories" asp-action="Index">Categories</a></div>
                </div>
                <div class="col-6 col-md-3 mb-3">
                    <div class="fw-bold text-white mb-2">Company</div>
                    <div><a asp-controller="Home" asp-action="About">About</a></div>
                    <div><a asp-controller="Home" asp-action="Contact">Contact</a></div>
                </div>
                <div class="col-6 col-md-3 mb-3">
                    <div class="fw-bold text-white mb-2">Account</div>
                    <div><a asp-controller="Account" asp-action="Login">Log in</a></div>
                    <div><a asp-controller="Account" asp-action="Register">Register</a></div>
                </div>
            </div>

            <div class="pw-wordmark">PATHWAY</div>

            <div class="pw-footer-bottom d-flex justify-content-between flex-wrap">
                <span>&copy; @DateTime.Now.Year Pathway. All rights reserved.</span>
                <span>Built for learners and instructors.</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

