@model Pathway.ViewModels.CourseDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<img src="@(Model.ImageUrl ?? "https://via.placeholder.com/900x300?text=Pathway+Course")"
     class="img-fluid rounded mb-4" style="width: 100%; height: 280px; object-fit: cover;"
     alt="@Model.Title" />

<span class="badge mb-2" style="background-color: var(--primary); color: white;">@Model.CategoryName</span>
<h2 class="mt-2">@Model.Title</h2>

<div class="row mb-4">
    <div class="col-md-8">
        <p class="text-muted">by <strong>@Model.InstructorName</strong></p>
        <p>@Model.Description</p>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0 p-3">
            <span class="fw-bold fs-3 mb-2" style="color: var(--primary);">@Model.Price.ToString("C")</span>
            <p class="text-muted mb-3">@Model.EnrollmentCount students enrolled</p>

            @if (User.IsInRole("Student"))
            {
                <form asp-controller="Enrollments" asp-action="Enroll" asp-route-courseId="@Model.CourseId" method="post">
                    <button type="submit" class="btn btn-primary w-100">Enroll in this Course</button>
                </form>
            }
        </div>
    </div>
</div>

<h4>Course Content</h4>
@if (!Model.Sections.Any())
{
    <p class="text-muted">No sections added yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var sec in Model.Sections.OrderBy(s => s.Order))
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <strong>@sec.Title</strong>
                <span class="text-muted small">@sec.LessonCount lessons</span>
            </li>
        }
    </ul>
}

<a asp-action="Index" class="btn btn-outline-secondary mt-4">← Back to all courses</a>