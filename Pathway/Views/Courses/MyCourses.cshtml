@model List<Pathway.ViewModels.CourseListItemViewModel>

@{
    ViewData["Title"] = "My Courses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">My Courses</h2>
    <a asp-action="Create" class="btn btn-primary">+ Create New Course</a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <p class="text-muted fs-5">You haven't created any courses yet.</p>
        <a asp-action="Create" class="btn btn-primary mt-2">Create Your First Course</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var course in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0" style="transition: transform 0.15s;">
                    <img src="@(course.ImageUrl ?? "https://via.placeholder.com/500x300?text=Pathway+Course")"
                         class="card-img-top" style="height: 160px; object-fit: cover; border-radius: 12px 12px 0 0;"
                         alt="@course.Title" />
                    <div class="card-body d-flex flex-column">
                        <span class="badge mb-2 align-self-start" style="background-color: var(--primary); color: white;">@course.CategoryName</span>
                        <h5 class="card-title">@course.Title</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            @(course.Description != null && course.Description.Length > 90
                                ? course.Description.Substring(0, 90) + "..."
                                : course.Description)
                        </p>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="fw-bold fs-5" style="color: var(--primary);">@course.Price.ToString("C")</span>
                            <span class="text-muted small">@course.EnrollmentCount enrolled</span>
                        </div>
                        <div class="d-flex gap-2 mt-3">
                            <a asp-action="Details" asp-route-id="@course.CourseId" class="btn btn-outline-secondary btn-sm flex-fill">View</a>
                            <a asp-action="Edit" asp-route-id="@course.CourseId" class="btn btn-outline-primary btn-sm flex-fill">Edit</a>
                            <a asp-action="Delete" asp-route-id="@course.CourseId" class="btn btn-outline-danger btn-sm flex-fill">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}