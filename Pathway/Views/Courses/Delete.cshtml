@model Pathway.Models.Course

@{
    ViewData["Title"] = "Delete Course";
}

<h2>Delete Course</h2>

<div class="alert alert-danger">
    <strong>Are you sure you want to delete this course?</strong> This action cannot be undone.
</div>

<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Description</dd>

    <dt class="col-sm-2">Price</dt>
    <dd class="col-sm-10">@Model.Price.ToString("C")</dd>

    <dt class="col-sm-2">Category</dt>
    <dd class="col-sm-10">@Model.Category?.Name</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.CourseId" method="post">
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="MyCourses" class="btn btn-secondary">Cancel</a>
</form>
