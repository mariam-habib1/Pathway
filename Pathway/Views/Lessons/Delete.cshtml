@model Pathway.Models.Lesson

@{
    ViewData["Title"] = "Delete Lesson";
}

<h1>Delete Lesson</h1>

<h3>Are you sure you want to delete this lesson?</h3>

<div>
    <h4>Lesson</h4> <hr />

    <dl class="row">

        <dt class="col-sm-2">
            Title
        </dt>
        <dd class="col-sm-10">
            @Model.Title
        </dd>

        <dt class="col-sm-2">
            Content
        </dt>
        <dd class="col-sm-10">
            @Model.Content
        </dd>

        <dt class="col-sm-2">
            Video URL
        </dt>
        <dd class="col-sm-10">
            @Model.VideoUrl
        </dd>

        <dt class="col-sm-2">
            Section
        </dt>
        <dd class="col-sm-10">
            @(Model.Section != null ? Model.Section.Title : "No Section")
        </dd>

        <dt class="col-sm-2">
            Order
        </dt>
        <dd class="col-sm-10">
            @Model.Order
        </dd>

    </dl>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="LessonId" />

        <input type="submit"
               value="Delete"
               class="btn btn-danger" />

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to List
        </a>

    </form>

</div>