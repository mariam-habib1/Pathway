@model Pathway.ViewModels.EnrollmentViewModel

@{
    ViewData["Title"] = "Enrollment Details";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<h2 class="mb-4">@Model.CourseTitle</h2>

<div class="row">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 p-4">
            <dl class="row mb-0">
                <dt class="col-sm-4">Instructor</dt>
                <dd class="col-sm-8">@Model.InstructorName</dd>

                <dt class="col-sm-4">Category</dt>
                <dd class="col-sm-8">@Model.CategoryName</dd>

                <dt class="col-sm-4">Price</dt>
                <dd class="col-sm-8">@Model.Price.ToString("C")</dd>

                <dt class="col-sm-4">Enrolled At</dt>
                <dd class="col-sm-8">@Model.EnrolledAt.ToString("dd MMM yyyy")</dd>

                <dt class="col-sm-4">Progress</dt>
                <dd class="col-sm-8">@Model.Progress%</dd>
            </dl>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card shadow-sm border-0 p-4">
            <h6 class="mb-3">Update Progress</h6>
            <form asp-action="UpdateProgress" asp-route-id="@Model.EnrollmentId" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <input type="number" name="Progress" min="0" max="100" value="@Model.Progress" class="form-control" style="width: 120px;" />
                </div>
                <button type="submit" class="btn btn-primary">Save Progress</button>
            </form>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Cancel" asp-route-id="@Model.EnrollmentId" class="btn btn-outline-danger">Cancel Enrollment</a>
    <a asp-action="MyCourses" class="btn btn-outline-secondary">← Back to My Courses</a>
</div>