@model Pathway.ViewModels.StudentDashboardViewModel

@{
    ViewData["Title"] = "My Courses";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="hero mb-4" style="padding: 40px 30px; text-align: left;">
    <h2 class="mb-1">Welcome back!</h2>
    <p class="mb-0" style="opacity: 0.9;">Keep up the momentum — here's where you left off.</p>
</div>

<div class="row text-center mb-4 g-3">
    <div class="col-md-3 col-6">
        <div class="card shadow-sm border-0 p-3">
            <h3 class="mb-0" style="color: var(--primary);">@Model.TotalCourses</h3>
            <span class="text-muted small">Total Courses</span>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card shadow-sm border-0 p-3">
            <h3 class="mb-0 text-success">@Model.CompletedCourses</h3>
            <span class="text-muted small">Completed</span>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card shadow-sm border-0 p-3">
            <h3 class="mb-0 text-warning">@Model.InProgressCourses</h3>
            <span class="text-muted small">In Progress</span>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card shadow-sm border-0 p-3">
            <h3 class="mb-0" style="color: var(--primary);">@Model.AverageProgress.ToString("0.#")%</h3>
            <span class="text-muted small">Average Progress</span>
        </div>
    </div>
</div>

<h4 class="mb-3">My Enrolled Courses</h4>

@if (!Model.Enrollments.Any())
{
    <div class="text-center py-5">
        <p class="text-muted fs-5">You are not enrolled in any courses yet.</p>
        <a asp-controller="Courses" asp-action="Index" class="btn btn-primary mt-2">Browse Courses</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model.Enrollments)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0" style="transition: transform 0.15s;">
                    <div class="card-body d-flex flex-column">
                        <span class="badge mb-2 align-self-start" style="background-color: var(--primary); color: white;">@item.CategoryName</span>
                        <h5 class="card-title">@item.CourseTitle</h5>
                        <p class="mb-1 small text-secondary">by @item.InstructorName</p>
                        <p class="text-muted small mb-2">Enrolled @item.EnrolledAt.ToString("dd MMM yyyy")</p>

                        <div class="mb-2">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Progress</span>
                                <span>@item.Progress%</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar" role="progressbar" style="width: @item.Progress%; background-color: var(--primary);"></div>
                            </div>
                        </div>

                        <a asp-action="Details" asp-route-id="@item.EnrollmentId" class="btn btn-outline-primary w-100 mt-auto">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

