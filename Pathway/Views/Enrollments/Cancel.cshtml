@model Pathway.ViewModels.EnrollmentViewModel

@{
    ViewData["Title"] = "Cancel Enrollment";
}

<h2 class="mb-4">Cancel Enrollment</h2>

<div class="alert alert-warning" style="max-width: 500px;">
    Are you sure you want to cancel your enrollment in <strong>@Model.CourseTitle</strong>?
</div>

<form asp-action="Cancel" asp-route-id="@Model.EnrollmentId" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Yes, Cancel Enrollment</button>
    <a asp-action="Details" asp-route-id="@Model.EnrollmentId" class="btn btn-outline-secondary">No, Go Back</a>
</form>