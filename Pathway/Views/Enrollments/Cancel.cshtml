@model Pathway.ViewModels.EnrollmentViewModel

@{
    ViewData["Title"] = "Cancel Enrollment";
}

<h2>Cancel Enrollment</h2>

<p>Are you sure you want to cancel your enrollment in <strong>@Model.CourseTitle</strong>?</p>

<form asp-action="Cancel" asp-route-id="@Model.EnrollmentId" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Yes, Cancel</button>
    <a asp-action="Details" asp-route-id="@Model.EnrollmentId" class="btn btn-secondary">No, Go Back</a>
</form>
