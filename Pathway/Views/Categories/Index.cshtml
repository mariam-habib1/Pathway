@model IEnumerable<Pathway.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Categories</h2>
    <a asp-action="Create" class="btn btn-primary">+ Create New Category</a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <p class="text-muted fs-5">No categories yet.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0" style="transition: transform 0.15s;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title" style="color: var(--primary);">@item.Name</h5>
                        <p class="card-text text-muted small flex-grow-1">@item.Description</p>
                        <span class="text-muted small mb-3">@(item.Courses?.Count ?? 0) courses</span>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-outline-secondary btn-sm flex-fill">Details</a>
                            <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-outline-primary btn-sm flex-fill">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-outline-danger btn-sm flex-fill">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}