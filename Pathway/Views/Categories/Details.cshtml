@model Pathway.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<h2 class="mb-4">@Model.Name</h2>

<div class="card shadow-sm border-0 p-4" style="max-width: 500px;">
    <dl class="row mb-0">
        <dt class="col-sm-4">Name</dt>
        <dd class="col-sm-8">@Model.Name</dd>

        <dt class="col-sm-4">Description</dt>
        <dd class="col-sm-8">@Model.Description</dd>

        <dt class="col-sm-4">Courses</dt>
        <dd class="col-sm-8">@(Model.Courses?.Count ?? 0)</dd>
    </dl>
</div>

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>