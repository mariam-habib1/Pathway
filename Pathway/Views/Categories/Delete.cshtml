@model Pathway.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<h2 class="mb-4">Delete Category</h2>

<div class="alert alert-danger" style="max-width: 500px;">
    <strong>Are you sure you want to delete this category?</strong> This action cannot be undone.
</div>

<div class="card shadow-sm border-0 p-4" style="max-width: 500px;">
    <dl class="row mb-0">
        <dt class="col-sm-4">Name</dt>
        <dd class="col-sm-8">@Model.Name</dd>

        <dt class="col-sm-4">Description</dt>
        <dd class="col-sm-8">@Model.Description</dd>
    </dl>
</div>

<form asp-action="Delete" class="mt-4">
    <input type="hidden" asp-for="CategoryId" />
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>