@model Pathway.Models.CourseSection

@{
    ViewData["Title"] = "Delete Course Section";
}

<h1>Delete Course Section</h1>

<h3>Are you sure you want to delete this section?</h3>

<hr />

<div>
    <dl class="row">

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Title)
        </dt>

        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Title)
        </dd>

        <dt class="col-sm-3">
            Course
        </dt>

        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Course.Title)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Order)
        </dt>

        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Order)
        </dd>

    </dl>

    <form asp-action="Delete" method="post">

        <input type="hidden"
               asp-for="SectionId" />

        <input type="submit"
               value="Delete"
               class="btn btn-danger" />

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to List
        </a>

    </form>

</div>