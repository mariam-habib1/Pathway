@model Pathway.Models.User

@{
    ViewData["Title"] = "Delete User";
}

<h2 class="mb-4">Delete User</h2>

<div class="alert alert-danger" style="max-width: 500px;">
    <strong>Are you sure you want to delete @Model.Name?</strong> This action cannot be undone.
</div>

<div class="card shadow-sm border-0 p-4" style="max-width: 500px;">
    <p class="mb-1"><strong>@Model.Name</strong></p>
    <p class="mb-1 text-muted">@Model.Email</p>
    <span class="badge bg-secondary align-self-start">@Model.Role</span>
</div>

<form asp-controller="Admin" asp-action="DeleteUserConfirmed" asp-route-id="@Model.UserId" method="post" class="mt-4">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Yes, Delete User</button>
    <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-secondary">Cancel</a>
</form>