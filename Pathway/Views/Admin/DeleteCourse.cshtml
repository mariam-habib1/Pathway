@model Pathway.Models.Course

@{
    ViewData["Title"] = "Delete Course";
}

<h2 class="mb-4">Delete Course</h2>

<div class="alert alert-danger" style="max-width: 500px;">
    <strong>Are you sure you want to delete this course?</strong> This action cannot be undone.
</div>

<div class="card shadow-sm border-0 p-4" style="max-width: 500px;">
    <p class="mb-1"><strong>@Model.Title</strong></p>
    <p class="text-muted mb-0">Course #@Model.CourseId</p>
</div>

<form asp-controller="Admin" asp-action="DeleteCourseConfirmed" asp-route-id="@Model.CourseId" method="post" class="mt-4">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Yes, Delete Course</button>
    <a asp-controller="Admin" asp-action="Courses" class="btn btn-outline-secondary">Cancel</a>
</form>