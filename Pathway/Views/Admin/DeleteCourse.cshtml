@model Pathway.Models.Course

@{
    ViewData["Title"] = "Delete Course";
}

<div class="admin-page">

    <div class="delete-card">

        <div class="delete-icon">
            ⚠️
        </div>

        <span class="dashboard-badge">
            DELETE COURSE
        </span>

        <h1>
            Delete Course?
        </h1>

        <p>
            Are you sure you want to delete this course?
            This action cannot be undone.
        </p>


        <div class="delete-course-info">

            <div class="course-icon">
                📚
            </div>

            <div>

                <strong>
                    @Model.Title
                </strong>

                <span>
                    Course #@Model.CourseId
                </span>

            </div>

        </div>


        <form asp-controller="Admin"
              asp-action="DeleteCourseConfirmed"
              asp-route-id="@Model.CourseId"
              method="post">

            @Html.AntiForgeryToken()


            <div class="form-actions">

                <button type="submit"
                        class="btn-danger">

                    Yes, Delete Course
                </button>


                <a asp-controller="Admin"
                   asp-action="Courses"
                   class="btn-secondary">

                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>