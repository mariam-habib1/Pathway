@model Pathway.Models.Course

@{
    ViewData["Title"] = "Course Details";
}

<h2 class="mb-1">@Model.Title</h2>
<p class="text-muted mb-4">@Model.Description</p>

<div class="card shadow-sm border-0 p-4" style="max-width: 500px;">
    <dl class="row mb-0">
        <dt class="col-sm-5">Course ID</dt>
        <dd class="col-sm-7">#@Model.CourseId</dd>

        <dt class="col-sm-5">Price</dt>
        <dd class="col-sm-7">$@Model.Price</dd>

        <dt class="col-sm-5">Instructor ID</dt>
        <dd class="col-sm-7">#@Model.InstructorId</dd>

        <dt class="col-sm-5">Category ID</dt>
        <dd class="col-sm-7">#@Model.CategoryId</dd>

        <dt class="col-sm-5">Created At</dt>
        <dd class="col-sm-7">@Model.CreatedAt.ToString("dd MMMM yyyy")</dd>
    </dl>
</div>

<div class="mt-4">
    <a asp-controller="Admin" asp-action="DeleteCourse" asp-route-id="@Model.CourseId" class="btn btn-danger">Delete Course</a>
    <a asp-controller="Admin" asp-action="Courses" class="btn btn-outline-secondary">← Back to Courses</a>
</div>/div>