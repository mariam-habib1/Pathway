@model Pathway.ViewModels.Admin.UserListItemViewModel

@{
    ViewData["Title"] = "تفاصيل المستخدم";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <h2 class="mb-4">تفاصيل المستخدم</h2>

        <table class="table table-bordered">
            <tr>
                <th>الاسم</th>
                <td>@Model.Name</td>
            </tr>
            <tr>
                <th>البريد الإلكتروني</th>
                <td>@Model.Email</td>
            </tr>
            <tr>
                <th>الدور</th>
                <td>@Model.Role</td>
            </tr>
            <tr>
                <th>تاريخ التسجيل</th>
                <td>@Model.CreatedAt.ToString("yyyy-MM-dd")</td>
            </tr>
        </table>

        <a asp-controller="Admin" asp-action="EditUser" asp-route-id="@Model.UserId" class="btn btn-warning">تعديل</a>
        <a asp-controller="Admin" asp-action="Users" class="btn btn-secondary">الرجوع لقائمة المستخدمين</a>
    </div>
</div>