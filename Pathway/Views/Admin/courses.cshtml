@model IEnumerable<Pathway.Models.Course>

@{
    ViewData["Title"] = "Manage Courses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Manage Courses</h2>
        <p class="text-muted mb-0">Monitor and manage all courses on Pathway.</p>
    </div>
    <span class="badge bg-secondary fs-6">@Model.Count() Courses</span>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <div class="fs-1 mb-2">📚</div>
        <h4>No Courses Found</h4>
        <p class="text-muted">There are currently no courses available.</p>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Course</th>
                    <th>Price</th>
                    <th>Instructor ID</th>
                    <th>Category ID</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in Model)
                {
                    <tr>
                        <td>#@course.CourseId</td>
                        <td><strong>@course.Title</strong></td>
                        <td style="color: var(--primary);">$@course.Price</td>
                        <td>#@course.InstructorId</td>
                        <td>#@course.CategoryId</td>
                        <td>@course.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            <a asp-controller="Admin" asp-action="CourseDetails" asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-secondary">View</a>
                            <a asp-controller="Admin" asp-action="DeleteCourse" asp-route-id="@course.CourseId" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}