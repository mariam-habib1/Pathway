@{
    ViewData["Title"] = "Statistics";
}

<div class="admin-page">

    <div class="page-header">

        <div>

            <span class="dashboard-badge">
                ANALYTICS
            </span>

            <h1>
                Platform Statistics
            </h1>

            <p>
                Overview of the Pathway learning platform.
            </p>

        </div>

    </div>


    <div class="stats-grid">

        <div class="stat-box">

            <div class="stat-icon">
                👥
            </div>

            <h2>
                @ViewBag.UsersCount
            </h2>

            <p>
                Total Users
            </p>

        </div>


        <div class="stat-box">

            <div class="stat-icon">
                📚
            </div>

            <h2>
                @ViewBag.CoursesCount
            </h2>

            <p>
                Total Courses
            </p>

        </div>


        <div class="stat-box">

            <div class="stat-icon">
                🏷️
            </div>

            <h2>
                @ViewBag.CategoriesCount
            </h2>

            <p>
                Total Categories
            </p>

        </div>


        <div class="stat-box">

            <div class="stat-icon">
                🎓
            </div>

            <h2>
                @ViewBag.EnrollmentsCount
            </h2>

            <p>
                Total Enrollments
            </p>

        </div>

    </div>


    <div class="analytics-card">

        <div>

            <span class="dashboard-badge">
                PLATFORM OVERVIEW
            </span>

            <h2>
                Pathway at a glance
            </h2>

            <p>
                These numbers represent the current
                data stored in the platform.
            </p>

        </div>


        <div class="analytics-list">

            <div>
                <span>Users</span>
                <strong>@ViewBag.UsersCount</strong>
            </div>

            <div>
                <span>Courses</span>
                <strong>@ViewBag.CoursesCount</strong>
            </div>

            <div>
                <span>Categories</span>
                <strong>@ViewBag.CategoriesCount</strong>
            </div>

            <div>
                <span>Enrollments</span>
                <strong>@ViewBag.EnrollmentsCount</strong>
            </div>

        </div>

    </div>

</div>