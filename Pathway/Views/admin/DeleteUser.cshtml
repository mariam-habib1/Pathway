@model Pathway.Models.User

@{
    ViewData["Title"] = "Delete User";
}

<div class="admin-page">

    <div class="delete-card">

        <div class="delete-icon">
            ⚠️
        </div>

        <span class="dashboard-badge">
            DELETE USER
        </span>

        <h1>
            Delete @Model.Name?
        </h1>

        <p>
            Are you sure you want to delete this user?
            This action cannot be undone.
        </p>


        <div class="delete-user-info">

            <strong>
                @Model.Name
            </strong>

            <span>
                @Model.Email
            </span>

            <span class="role-badge">
                @Model.Role
            </span>

        </div>


        <form asp-controller="Admin"
              asp-action="DeleteUserConfirmed"
              asp-route-id="@Model.UserId"
              method="post">

            @Html.AntiForgeryToken()


            <div class="form-actions">

                <button type="submit"
                        class="btn-danger">

                    Yes, Delete User
                </button>


                <a asp-controller="Admin"
                   asp-action="Users"
                   class="btn-secondary">

                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>